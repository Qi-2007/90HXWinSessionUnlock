[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/19/2026,0.6.10.0
CatalogFile=CMP90HXUnlockSession.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTamd64.10.0...19041

[Devices.NTamd64.10.0...19041]
%Device%=Install,PCI\VEN_10DE&DEV_220D

[Install.NT]
CopyFiles=DriverCopy

[Install.NT.HW]
AddReg=DeviceDmaRemapping

[DeviceDmaRemapping]
HKR,"DMA Management","RemappingSupported",0x00010001,1
HKR,"DMA Management","RemappingFlags",0x00010001,0

[Install.NT.Services]
AddService=CMP90HXUnlockSession,0x00000002,DriverService

[DriverService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\CMP90HXUnlockSession.sys
AddReg=ServiceDmaRemapping

[ServiceDmaRemapping]
HKR,Parameters,DmaRemappingCompatible,0x00010001,1

[DestinationDirs]
DriverCopy=13

[DriverCopy]
CMP90HXUnlockSession.sys

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
CMP90HXUnlockSession.sys=1

[Strings]
Provider="Qi"
Device="CMP 90HX Session Unlock Driver"
Disk="CMP 90HX Windows Unlock"
